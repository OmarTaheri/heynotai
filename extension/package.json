{
  "name": "@heynotai/extension",
  "version": "1.0.1",
  "description": "Check text, images, and supported videos for signs of AI generation while you browse.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:local": "wxt build --mode development",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "wxt build --mode development && playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@heynotai/shared": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.0.290",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.1.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5",
    "wxt": "^0.20.0"
  }
}
