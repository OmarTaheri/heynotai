{
  "name": "heynotai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:frontend": "pnpm --filter @heynotai/frontend dev",
    "dev:extension": "pnpm --filter @heynotai/extension dev",
    "dev:api": "pnpm --filter @heynotai/api dev",
    "build:frontend": "pnpm --filter @heynotai/frontend build",
    "build:extension": "pnpm --filter @heynotai/extension build",
    "build:api": "pnpm --filter @heynotai/api build",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel --if-present test",
    "db:up": "docker compose --env-file .env.local-stack -f docker-compose.yaml -f docker-compose.override.local.yml up -d postgres",
    "stack:up": "docker compose --env-file .env.local-stack -f docker-compose.yaml -f docker-compose.override.local.yml up -d",
    "stack:down": "docker compose --env-file .env.local-stack -f docker-compose.yaml -f docker-compose.override.local.yml down"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0"
}
