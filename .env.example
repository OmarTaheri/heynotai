POSTGRES_DB=heynotai
POSTGRES_USER=heynotai
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_POOL_SIZE=10

NEXT_PUBLIC_API_URL=http://localhost:8787
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:3000,chrome-extension://*
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

AUTH_PASSWORD_PEPPER=replace-with-a-different-long-random-value
FILE_URL_SECRET=replace-with-an-independent-long-random-value
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters
AUTH_ACCESS_TTL_SECONDS=3600
AUTH_REFRESH_TTL_SECONDS=2592000
ADMIN_EMAILS=admin@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback
# Comma-separated Chrome extension IDs allowed to complete the sign-in
# handoff. First is the published store build, second the pinned dev/local
# build. An ID missing here fails sign-in with `invalid_extension_redirect`.
EXTENSION_IDS=dmnmdeccfhicgfjmcehkmpkfpakccbkj,blffhfijmlabjphlccpmdhjkninakchg
ALLOWED_LOCAL_MODEL_HOSTS=localhost,127.0.0.1

HUGGINGFACE_TOKEN=
VELMA_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_VERIFY_MONTHLY=
STRIPE_PRICE_VERIFY_YEARLY=
STRIPE_PRICE_CERTIFY_MONTHLY=
STRIPE_PRICE_CERTIFY_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
