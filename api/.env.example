PORT=8787
DATABASE_URL=postgres://heynotai:change-me@127.0.0.1:5432/heynotai
DATABASE_POOL_SIZE=10
UPLOAD_DIR=./data/uploads
API_PUBLIC_URL=http://localhost:8787
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,chrome-extension://*

# Structured logs always land in the system_logs table. This additionally
# mirrors them to stdout/stderr so `pnpm dev` and `docker logs` show traffic.
# auto = readable lines in development, one JSON object per line in production.
LOG_STDOUT=auto
LOG_STDOUT_LEVEL=info

# Session/auth security. Use independent random values in production.
# Example generators:
#   openssl rand -base64 48
#   openssl rand -hex 32
AUTH_PASSWORD_PEPPER=
FILE_URL_SECRET=
AUTH_ACCESS_TTL_SECONDS=2592000
AUTH_REFRESH_TTL_SECONDS=2592000
CREDENTIAL_ENCRYPTION_KEY=
ADMIN_EMAILS=admin@example.com

# Development-only login shortcuts. `npm run dev` refreshes these two local
# accounts before starting the API. Keep the frontend NEXT_PUBLIC values in sync
# if you override them.
DEV_ADMIN_EMAIL=admin@heynotai.local
DEV_USER_EMAIL=user@heynotai.local
DEV_LOGIN_PASSWORD=HeyNotAI2026!

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0
# Authorized web redirect URI must exactly match GOOGLE_REDIRECT_URI.
# Google compares the string byte for byte and answers an unregistered value
# with "Error 400: redirect_uri_mismatch". The callback belongs to the API, not
# the frontend, and both the website and the extension flows use this one URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback
# Comma-separated Chrome extension IDs allowed to finish OAuth.
EXTENSION_IDS=
ALLOWED_LOCAL_MODEL_HOSTS=localhost,127.0.0.1

# Provider credentials can be stored encrypted through /app/admin/providers.
# These environment values are optional fallbacks for the seeded providers.
HUGGINGFACE_TOKEN=
# Optional fallback for the self-hosted Modal audio provider. Prefer entering
# it in Admin > Providers so it is encrypted in PostgreSQL.
MODAL_AUDIO_API_KEY=
VELMA_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_VERIFY_MONTHLY=
STRIPE_PRICE_VERIFY_YEARLY=
STRIPE_PRICE_CERTIFY_MONTHLY=
STRIPE_PRICE_CERTIFY_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
