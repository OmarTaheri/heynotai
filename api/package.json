{
  "name": "@heynotai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "tsx scripts/seed-dev-auth.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:integration": "tsx scripts/verify-auth-sync.ts",
    "probe:models": "tsx scripts/probe-detection-models.ts"
  },
  "dependencies": {
    "@heynotai/shared": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "hono": "^4.6.15",
    "jose": "6.1.0",
    "postgres": "3.4.9",
    "stripe": "^22.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
