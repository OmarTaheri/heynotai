# Local development. VITE_FRONTEND_URL must match the port `pnpm dev:frontend`
# actually serves (3010) — the drawer opens <VITE_FRONTEND_URL>/extension-auth
# inside chrome.identity, and a wrong port surfaces in the drawer as
# "Authorization page could not be loaded."
VITE_API_URL=http://localhost:8787
VITE_FRONTEND_URL=http://localhost:3010
