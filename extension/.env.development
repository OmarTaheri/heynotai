# Local development + the Playwright end-to-end suite.
#
# `wxt build` defaults to production mode, which bakes the URLs from
# .env.production into the bundle — an E2E run against that build talks
# to the live API and every signed-in assertion fails. `wxt build --mode
# development` (pnpm build:local, pnpm e2e) picks this file up instead.
#
# VITE_FRONTEND_URL must match the port `pnpm dev:frontend` actually
# serves (3010) — the drawer opens <VITE_FRONTEND_URL>/extension-auth
# inside chrome.identity, and a wrong port surfaces in the drawer as
# "Authorization page could not be loaded."
VITE_API_URL=http://localhost:8787
VITE_FRONTEND_URL=http://localhost:3010
